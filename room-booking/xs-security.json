{
  "xsappname": "room-booking",
  "tenant-mode": "dedicated",
  "description": "Security for Room Booking System",
  "oauth2-configuration": {
    "token-validity": 3600,
    "refresh-token-validity": 43200,
    "redirect-uris": [
      "https://*.cfapps.us10-001.hana.ondemand.com/**",
      "https://*.hana.ondemand.com/**"
    ]
  },
  "scopes": [
    {
      "name": "$XSAPPNAME.User",
      "description": "Access to Room Booking"
    }
  ],
  "attributes": [],
  "role-templates": [
    {
      "name": "User",
      "description": "Access to Room Booking",
      "scope-references": [
        "$XSAPPNAME.User"
      ]
    }
  ],
  "role-collections": [
    {
      "name": "RoomBooking_User",
      "description": "Access to Room Booking application",
      "role-template-references": [
        "$XSAPPNAME.User"
      ]
    }
  ]
}