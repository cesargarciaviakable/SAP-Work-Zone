{
  "name": "room-booking",
  "version": "1.0.0",
  "dependencies": {
    "@cap-js/hana": "^2.8.0",
    "@sap/cds": "^9",
    "@sap/xssec": "^4.15.0"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^2.4",
    "@sap/cds-dk": "^9",
    "cds-plugin-ui5": "^0.17.0",
    "mbt": "^1.2.49",
    "rimraf": "^5.0.5"
  },
  "cds": {
    "fiori": {
      "bypass_draft": true
    },
    "requires": {
      "db": {
        "[hybrid]": {
          "kind": "hana"
        },
        "[production]": {
          "kind": "hana"
        }
      }
    },
    "[production]": {
      "requires": {
        "auth": "xsuaa"
      }
    }
  },
  "scripts": {
    "start": "cds-serve",
    "watch-bookings": "cds watch --open room.booking.bookings/index.html?sap-ui-xx-viewCache=false --livereload false",
    "undeploy": "cf undeploy room-booking --delete-services --delete-service-keys --delete-service-brokers",
    "build": "rimraf resources mta_archives && mbt build --mtar archive",
    "deploy": "cf deploy mta_archives/archive.mtar --retries 1"
  },
  "private": true,
  "workspaces": [
    "app/*"
  ],
  "sapux": [
    "app/bookings"
  ]
}
