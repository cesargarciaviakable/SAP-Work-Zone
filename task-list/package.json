{
  "name": "task-list",
  "version": "1.0.0",
  "dependencies": {
    "@sap/cds": "^9",
    "@sap/xssec": "^4.15.0"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^2.4",
    "@sap/cds-dk": "^9",
    "cds-plugin-ui5": "^0.17.0",
    "mbt": "^1.2.49",
    "rimraf": "^5.0.5"
  },
  "scripts": {
    "start": "cds-serve",
    "watch-task": "cds watch --open task.list.task/index.html?sap-ui-xx-viewCache=false --livereload false",
    "watch-tasks": "cds watch --open task.list.tasks/index.html?sap-ui-xx-viewCache=false --livereload false",
    "undeploy": "cf undeploy task-list --delete-services --delete-service-keys --delete-service-brokers",
    "build": "rimraf resources mta_archives && mbt build --mtar archive",
    "deploy": "cf deploy mta_archives/archive.mtar --retries 1",
    "watch-approvals": "cds watch --open task.list.approvals/index.html?sap-ui-xx-viewCache=false --livereload false"
  },
  "private": true,
  "workspaces": [
    "app/*"
  ],
  "sapux": [
    "app/task",
    "app/tasks",
    "app/approvals"
  ]
}
