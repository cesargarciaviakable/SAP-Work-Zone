{
  "_version": "1.89.0",
  "sap.app": {
    "id": "lote.inspector.app.qminspector",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:lrop",
      "version": "1.32.0",
      "toolsId": "9ac183f9-f0aa-4f04-86c5-a9b84a04f427"
    },
    "dataSources": {
      "mainService": {
        "uri": "/inspector/",
        "type": "OData",
        "settings": {
          "annotations": [],
          "odataVersion": "4.0"
        }
      }
    },
    "crossNavigation": {
      "inbounds": {
        "LoteInspector-manage": {
          "semanticObject": "LoteInspector",
          "action": "manage",
          "title": "{{LoteInspector-manage.flpTitle}}",
          "signature": {
            "parameters": {},
            "additionalParameters": "allowed"
          }
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.152.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.fe.templates": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "lote.inspector.app.qminspector.i18n.i18n"
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      },
      "@i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "uri": "i18n/i18n.properties"
      }
    },
    "resources": {
      "css": []
    },
    "routing": {
      "config": {},
      "routes": [
        {
          "pattern": ":?query:",
          "name": "LotesList",
          "target": "LotesList"
        },
        {
          "pattern": "Lotes({key}):?query:",
          "name": "LotesObjectPage",
          "target": "LotesObjectPage"
        },
        {
          "pattern": "Lotes({key})/inspecciones({key2}):?query:",
          "name": "InspeccionesObjectPage",
          "target": "InspeccionesObjectPage"
        }
      ],
      "targets": {
        "LotesList": {
          "type": "Component",
          "id": "LotesList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/Lotes",
              "variantManagement": "Page",
              "navigation": {
                "Lotes": {
                  "detail": {
                    "route": "LotesObjectPage"
                  }
                }
              },
              "controlConfiguration": {
                "@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": {
                    "type": "ResponsiveTable"
                  }
                }
              }
            }
          }
        },
        "LotesObjectPage": {
          "type": "Component",
          "id": "LotesObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "editableHeaderContent": false,
              "contextPath": "/Lotes",
              "navigation": {
                "inspecciones": {
                  "detail": {
                    "route": "InspeccionesObjectPage"
                  }
                }
              }
            }
          }
        },
        "InspeccionesObjectPage": {
          "type": "Component",
          "id": "InspeccionesObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "editableHeaderContent": false,
              "contextPath": "/Lotes/inspecciones"
            }
          }
        }
      }
    }
  },
  "sap.fiori": {
    "registrationIds": [],
    "archeType": "transactional"
  },
  "sap.fe": {
    "app": {
      "enableLazyLoading": true
    }
  }
}
